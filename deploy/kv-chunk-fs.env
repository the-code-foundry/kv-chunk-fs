# kv-chunk-fs settings (/etc/kv-chunk-fs.env, read by the unit and by the
# program). Any setting of `kv-chunk-fs config` can go here as KVCFS_<NAME>;
# environment beats this file only for variables set elsewhere. install.sh
# installs this file once (with its paths filled in) and never overwrites a
# local copy.
KVCFS_BACKING=/srv/kv-cache.backing
KVCFS_MOUNT=/srv/kv/cache

# HTTP API, off unless set. No authentication: keep it local or secure it.
KVCFS_API_SOCKET=/run/kv-chunk-fs/api.sock
KVCFS_API_HOST=127.0.0.1
KVCFS_API_PORT=9474

#KVCFS_LOG_BUFFER_LINES=1000
#KVCFS_GC_INTERVAL=1h
#KVCFS_CACHE_MIB=256
#KVCFS_SCORE_UNIQUE_WEIGHT=1
#KVCFS_SCORE_SIZE_WEIGHT=0
#KVCFS_SCORE_USES_WEIGHT=1
#KVCFS_SCORE_HALF_LIFE=24h
